[Unit]
Description=AvianVisitors ThermoPro TX-2 receiver (RXB6 on GPIO)
After=local-fs.target

[Service]
Type=simple
User=__USER__
SupplementaryGroups=gpio
EnvironmentFile=-/etc/avian/thermopro.env
Environment=LG_WD=/var/lib/avian-thermopro
WorkingDirectory=/var/lib/avian-thermopro
ExecStart=/usr/bin/python3 __REPO__/avian/thermopro/thermopro_rx.py $THERMOPRO_ARGS
StateDirectory=avian-thermopro
StateDirectoryMode=0755
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
